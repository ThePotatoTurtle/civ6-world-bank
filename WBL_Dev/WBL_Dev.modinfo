      <File>Scripts/WBL_SpikeDryRun.lua</File>
      <File>UI/WBL_Dev_Telemetry.lua</File>
    </ImportFiles>
    <AddGameplayScripts id="WBL_DEV_Gameplay" criteria="WBL_DEV_XP2">
      <File>Scripts/WBL_Spikes.lua</File>
    </AddGameplayScripts>
    <AddUserInterfaces id="WBL_DEV_UI" criteria="WBL_DEV_XP2">
      <Properties><Context>InGame</Context></Properties>
      <File>UI/WBL_Dev_Panel.xml</File>
    </AddUserInterfaces>
  </InGameActions>
  <LocalizedText>
    <Text id="LOC_WBL_DEV_TITLE"><en_US>World Bank Loans Dev v0.0.0.4</en_US></Text>
    <Text id="LOC_WBL_DEV_TEASER"><en_US>World Bank Loans API spikes. New test games only.</en_US></Text>
    <Text id="LOC_WBL_NOTIFY_LOAN_TAKEN_MESSAGE"><en_US>World Bank Loans dev: adapter notification test</en_US></Text>
    <Text id="LOC_WBL_NOTIFY_LOAN_TAKEN_SUMMARY"><en_US>Sent by the S9 notify spike through the production adapter.</en_US></Text>
    <Text id="LOC_WBL_DEV_DESCRIPTION"><en_US>Version 0.0.0.4.[NEWLINE]World Bank Loans research tools. Open Bank on the launch bar or press Ctrl+Shift+D. Run All Spikes writes results to Lua.log. Bank Dry Run logs the in-memory bank pipeline without applying anything. AI deal inspections are nonbinding. Requires Gathering Storm. Engine behavior and multiplayer remain unverified. Never enable this in a real game.</en_US></Text>
  </LocalizedText>
