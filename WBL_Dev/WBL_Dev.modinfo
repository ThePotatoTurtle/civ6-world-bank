<?xml version="1.0" encoding="utf-8"?>
<Mod id="32999527-94bd-4e64-b7cb-66329ffaf673" version="1">
  <Properties>
    <Name>LOC_WBL_DEV_TITLE</Name>
    <Teaser>LOC_WBL_DEV_TEASER</Teaser>
    <Description>LOC_WBL_DEV_DESCRIPTION</Description>
    <Authors>ThePotatoTurtle</Authors>
    <AffectsSavedGames>1</AffectsSavedGames>
    <CompatibleVersions>2.0</CompatibleVersions>
  </Properties>
  <Dependencies>
    <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm"/>
  </Dependencies>
  <ActionCriteria>
    <Criteria id="WBL_DEV_XP2"><GameCoreInUse>Expansion2</GameCoreInUse></Criteria>
  </ActionCriteria>
  <InGameActions>
    <UpdateDatabase id="WBL_DEV_Data" criteria="WBL_DEV_XP2">
      <File>Data/WBL_SpikeModifiers.sql</File>
      <File>Data/WBL_Penalties.sql</File>
      <File>Data/WBL_DevNotifications.xml</File>
    </UpdateDatabase>
    <ImportFiles id="WBL_DEV_Imports" criteria="WBL_DEV_XP2">
      <File>Scripts/WBL_Config.lua</File>
      <File>Scripts/WBL_Math.lua</File>
      <File>Scripts/WBL_SpikeMilestones.lua</File>
      <File>Scripts/WBL_SpikePlayerEffects.lua</File>
      <File>Scripts/WBL_SpikeAI.lua</File>
      <File>Scripts/WBL_SpikeDisasterRecovery.lua</File>
