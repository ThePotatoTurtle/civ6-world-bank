          <Label ID="ConfirmLines" Style="FontNormal16" Color="208,212,217,255" WrapWidth="484" String=""/>
          <Label ID="ConfirmNote" Style="FontNormal14" Color="168,180,194,255" WrapWidth="484" String="LOC_WBL_UI_WARN_NOTE"/>
        </Stack>
        <GridButton ID="ConfirmCancel" Anchor="L,B" Offset="28,24" Size="230,40" Style="MainButton" String="LOC_WBL_UI_WARN_CANCEL"/>
        <GridButton ID="ConfirmOk" Anchor="R,B" Offset="28,24" Size="230,40" Style="MainButton" String="LOC_WBL_UI_WARN_OK"/>
      </Grid>
    </Container>
